{
  "name": "wanalab-web",
  "private": true,
  "version": "2.1.0",
  "description": "WanaLab.pk - Independent Research Lab, WANA - 9 Prime Tools - Offline - Built in Wana, Used Worldwide",
  "author": "WanaLab.pk - Independent Research Lab, WANA",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build-exe": "npm run build && electron-builder --win portable",
    "build-installer": "npm run build && electron-builder --win nsis",
    "build-all": "npm run build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "pk.wanalab.web",
    "productName": "WanaLab",
    "copyright": "Copyright © 2026 WanaLab.pk - Engineered in WANA",
    "files": [
      "dist/**/*",
      "electron.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/vite.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WanaLab",
      "artifactName": "WanaLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WanaLab-Portable-${version}.${ext}"
    }
  }
}
